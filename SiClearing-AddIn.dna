<DnaLibrary Name="SiClearing Add-In" RuntimeVersion="v4.0" ExplicitExports="false">
  <ExternalLibrary Path="SiClearing.dll" ExplicitExports="false" LoadFromBytes="false" Pack="true" />

  <CustomUI>
    <customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui"
              onLoad="OnRibbonLoad">
      <ribbon>
        <tabs>
          <tab id="tabSiClearing" label="SiClearing">
            <group id="grpDownload" label="Download">
              <button id="btnRefresh"
                      label="Refresh SiClearing"
                      imageMso="Refresh"
                      size="large"
                      onAction="OnRefresh"
                      screentip="Scarica l'ultimo CSV SiClearing da Outlook"/>
            </group>
            <group id="grpSettings" label="Impostazioni">
              <button id="btnSettings"
                      label="Impostazioni"
                      imageMso="PropertySheet"
                      size="normal"
                      onAction="OnSettings"
                      screentip="Configura parametri SiClearing"/>
              <button id="btnDebug"
                      label="Debug Outlook"
                      imageMso="OutlookGlobe"
                      size="normal"
                      onAction="OnDebugFolders"
                      screentip="Mostra struttura cartelle Outlook"/>
            </group>
            <group id="grpLog" label="Diagnostica">
              <button id="btnLog"
                      label="Log"
                      imageMso="ControlLayoutRemoveColumns"
                      size="normal"
                      onAction="OnOpenLog"
                      screentip="Apre la finestra di log"/>
            </group>
          </tab>
        </tabs>
      </ribbon>
    </customUI>
  </CustomUI>
</DnaLibrary>
